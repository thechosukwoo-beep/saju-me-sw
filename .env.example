# Google AI Studio에서 발급한 Gemini API 키
# https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Supabase 프로젝트 연결 정보
# Dashboard > Project Settings > API 또는 Connect 패널에서 확인
# https://supabase.com/dashboard/project/bynonfwyzslmsqdrbffm
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google 로그인 설정은 .env가 아니라
# 1) Google Cloud OAuth Client ID/Secret
# 2) Supabase Auth > Providers > Google
# 3) Supabase Auth > URL Configuration (http://localhost:5173)
# 에서 연결합니다. 자세한 단계는 README를 참고하세요.
